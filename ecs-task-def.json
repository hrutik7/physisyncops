{
  "family": "physisync-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::378457871865:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::378457871865:role/physisync-task-role",
  "containerDefinitions": [
    {
      "name": "physisync-web",
      "image": "378457871865.dkr.ecr.us-east-1.amazonaws.com/physisync:${IMAGE_TAG}",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "AWS_DEFAULT_REGION", "value": "us-east-1" }
      ]
    }
  ]
}
